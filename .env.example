DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?connection_limit=1&pgbouncer=true&statement_cache_size=0"
# 教学分析、教案生成与课堂问答：填写下面三项
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
# 知识库语义检索：硅基流动国内站，需要该平台自己的 API Key
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIMENSIONS=2560
STORAGE_PROVIDER=local
STORAGE_PATH=./storage
# 可选联网搜索：使用时填写 Tavily 密钥
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
ALLOW_DEMO_LOGIN=true
ADMIN_EMAILS=demo@writewise.local
APP_URL=http://localhost:3000
MAX_UPLOAD_MB=15
